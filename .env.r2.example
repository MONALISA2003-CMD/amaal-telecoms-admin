# Cloudflare R2 server-side credentials. Never expose these to NEXT_PUBLIC_* variables.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=amaal-product-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional now; set later when a custom domain is available.
R2_PUBLIC_URL=
# Keep existing database/auth/payment variables unchanged.
