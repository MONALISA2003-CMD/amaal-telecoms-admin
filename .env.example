PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# Emergency administrator recovery; keep secret and remove/rotate immediately after use.
ADMIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token

# AI Business Intelligence — keep server-side only; never expose to browser
# Google AI Studio now creates authorization keys by default. Use a current restricted Gemini API key.
GEMINI_API_KEY=
# Optional alias accepted by the Gemini client integration
GOOGLE_API_KEY=

# Encrypts integration credentials at rest. Use a long random secret and keep it outside GitHub.
INTEGRATION_ENCRYPTION_KEY=

# Comma-separated public website origins allowed to call public catalogue, checkout, account, search and service APIs. Example: https://www.amaaltelecoms.com,https://your-public-site.vercel.app
PUBLIC_WEB_ORIGINS=

# Deferred until the custom domain and production sender email are ready.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=
# Development-only fallback: expose invitation tokens in API responses when true. Keep false in production.
ALLOW_MANUAL_INVITATION_TOKENS=false

# Backup & recovery operations — keep backup storage private and outside public/static directories.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
PG_DUMP_BIN=pg_dump
BACKUP_STALE_HOURS=30
# PostgreSQL restore execution is intentionally disabled by application policy.
# Recovery plans may target only this isolated environment name. Never set it to production.
RECOVERY_TARGET_ENV=staging-recovery
# Separate isolated Neon recovery database. Must never equal DATABASE_URL.
RECOVERY_DATABASE_URL=postgresql://USER:PASSWORD@RECOVERY-HOST:5432/RECOVERY_DATABASE?sslmode=require

# Provider-neutral payment configuration. Leave blank until Amaal selects and
# supplies production gateway credentials. Never expose payment secrets to the browser.
# Provider-neutral payment configuration. Keep secrets out of source control.
PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_CALLBACK_URL=
PAYMENT_CURRENCY=UGX
PAYMENT_COUNTRY=UG

# Customer Google OAuth/OpenID Connect. Keep client secret server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PUBLIC_WEB_URL=
